# ---- Duong dan ----
VAULT_DIR=./data/raw
DB_PATH=./db/knowledge.db
PORT=3900

# ---- Embedding (bat buoc, dung endpoint kieu OpenAI /v1/embeddings) ----
# Vi du Ollama local (mien phi, offline):
#   ollama pull nomic-embed-text
#   EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_API_KEY=ollama   (Ollama khong check key nhung field khong duoc rong)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama
EMBEDDING_DIM=768

# ---- Contextual Retrieval (tuy chon nhung khuyen nghi bat, xem README) ----
# Dung qua 9router hoac bat ky endpoint OpenAI-compatible nao de sinh
# 1-2 cau ngu canh cho tung chunk truoc khi embed (Anthropic Contextual Retrieval).
CONTEXTUAL_RETRIEVAL_ENABLED=true
CHAT_BASE_URL=https://your-9router-endpoint/v1
CHAT_MODEL=claude-haiku-4-5-20251001
CHAT_API_KEY=CHANGE_ME

# ---- Bao mat MCP server (tuy chon, khuyen nghi bat khi expose remote) ----
MCP_AUTH_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
