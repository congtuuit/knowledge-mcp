{
  "name": "knowledge-mcp",
  "version": "0.1.0",
  "description": "Kho kien thuc ca nhan (local) expose qua MCP streamable-HTTP cho Claude Code, ChatGPT/Codex, Antigravity CLI va bat ky MCP client nao.",
  "type": "module",
  "main": "dist/src/mcp-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/mcp-server.js",
    "dev": "tsx src/mcp-server.ts",
    "reindex": "tsx scripts/reindex.ts",
    "reindex:build": "node dist/scripts/reindex.js",
    "test": "tsx scripts/test-mcp-server.ts",
    "test:all": "tsx scripts/test-db.ts && tsx scripts/test-chunker.ts && tsx scripts/test-search.ts && tsx scripts/test-mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
